---
import { profile } from "../data/profile";

interface Props {
  /** Route to render the header as. Overridable so the door underlay can show
      the archive's header while it is still sitting on a project page. */
  pathname?: string;
}

const base = import.meta.env.BASE_URL;
const { pathname = Astro.url.pathname } = Astro.props;
const pageLabel = pathname === base ? "home" : pathname.slice(base.length).replace(/\/$/, "");

const navItems = [
  { href: base, label: "home" },
  { href: `${base}projects`, label: "projects" },
  { href: `${base}blog`, label: "blog" },
  { href: `${base}uses`, label: "uses" },
  { href: `${base}about`, label: "about" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href={base}>
      <span class="site-brand__handle">{profile.handle}</span>
      <span class="site-brand__separator">&middot;</span>
      <span class="site-brand__label">{pageLabel}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="site-nav">
        {
          navItems.map((item) => {
            const isActive =
              item.href === base
                ? pathname === base
                : pathname === item.href || pathname.startsWith(`${item.href}/`);

            return (
              <li>
                <a aria-current={isActive ? "page" : undefined} href={item.href}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
