---
import { profile } from "../data/profile";

const pathname = Astro.url.pathname;
const pageLabel = pathname === "/" ? "home" : pathname.replace(/^\/|\/$/g, "");

const navItems = [
  { href: "/", label: "~" },
  { href: "/projects", label: "projects" },
  { href: "/blog", label: "blog" },
  { href: "/uses", label: "uses" },
  { href: "/about", label: "about" },
  { href: "/lab", label: "lab" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/">
      <span class="site-brand__handle">{profile.handle}</span>
      <span class="site-brand__separator">~</span>
      <span class="site-brand__label">{pageLabel}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="site-nav">
        {
          navItems.map((item) => {
            const isActive =
              item.href === "/"
                ? pathname === "/"
                : pathname === item.href || pathname.startsWith(`${item.href}/`);

            return (
              <li>
                <a aria-current={isActive ? "page" : undefined} href={item.href}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
