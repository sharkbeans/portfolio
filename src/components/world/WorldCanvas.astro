---
import { worldInteractables } from "../../data/world";
---

<div data-world-root>
  <canvas id="world-canvas" class="world-canvas" aria-hidden="true"></canvas>

  <div class="world-controls">
    <p class="world-controls__hint">
      <kbd>WASD</kbd> / arrows to move · <kbd>Shift</kbd> to run · <kbd>E</kbd> to interact ·
      hold <kbd>Q</kbd> for the page selector · scroll still works
    </p>
    <button
      type="button"
      class="world-toggle"
      data-world-reading-toggle
      aria-pressed="false"
    >
      Reading mode
    </button>
  </div>

  <pre class="world-debug" data-world-debug hidden></pre>

  {import.meta.env.DEV && (
    <div class="world-debug-weather" data-world-debug-weather>
      <p class="world-debug-weather__label">weather (dev only)</p>
      <div class="world-debug-weather__row" role="group" aria-label="Weather condition override">
        <button type="button" data-weather-condition="clear">clear</button>
        <button type="button" data-weather-condition="rain">rain</button>
      </div>
      <div class="world-debug-weather__row" role="group" aria-label="Time of day override">
        <button type="button" data-weather-period="day">day</button>
        <button type="button" data-weather-period="night">night</button>
      </div>
      <button type="button" class="world-debug-weather__reset" data-weather-reset>live</button>
    </div>
  )}

  <dialog id="world-dialog" class="world-dialog" aria-label="World interaction preview" data-world-ignore-keys="true">
    <div class="world-dialog__chrome">
      <button type="button" data-world-dialog-close aria-label="Close preview">close</button>
    </div>

    {
      worldInteractables.map((target) => (
        <article data-world-preview={target.id} hidden>
          <p class="eyebrow">preview</p>
          <h3>{target.title}</h3>
          <p>{target.description}</p>
          <p>
            <a href={target.href}>{target.ctaLabel}</a>
          </p>
        </article>
      ))
    }
  </dialog>
</div>

<script>
  let teardown: (() => void) | null = null;
  let booting = false;

  function boot() {
    const root = document.querySelector<HTMLElement>("[data-world-root]");
    if (!root || booting || teardown) return;
    booting = true;

    import("./world")
      .then(({ initWorld }) => {
        // The page can be navigated away from while the chunk is still
        // loading, leaving this root detached — mounting into it would spin up
        // a world with nothing to draw on and no way to reach its teardown.
        if (!root.isConnected) {
          booting = false;
          return;
        }
        teardown = initWorld(root);
        root.dataset.enhanced = "true";
      })
      .catch(() => {
        booting = false;
        root.dataset.enhanced = "failed";
      });
  }

  function schedule() {
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(() => boot(), { timeout: 1200 });
    } else {
      setTimeout(() => boot(), 250);
    }
  }

  function dispose() {
    teardown?.();
    teardown = null;
    booting = false;
  }

  // The world lives on one page, but nothing about it is scoped to that page:
  // its update loop, its window-level input listeners and its scroll-following
  // camera all survive a client-side navigation. Left running, the camera keeps
  // scrolling whatever page came next back toward a player that is no longer on
  // screen. So it is torn down before every swap and re-mounted by the page
  // load that follows, if the new page has a world root at all.
  document.addEventListener("astro:before-swap", dispose);
  document.addEventListener("astro:page-load", schedule);

  schedule();
</script>
