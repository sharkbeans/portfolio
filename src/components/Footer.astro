---
import { profile } from "../data/profile";

const spriteUrl = `${import.meta.env.BASE_URL}assets/logo/logo-blink.png`;
---

<footer class="site-footer">
  <p class="site-footer__brand">
    <span class="footer-mark" aria-hidden="true"></span>
    <strong>{profile.handle}</strong> on the web.
  </p>
  <p>
    Source: <span>{profile.sourceRepository}</span>
  </p>
</footer>

<style define:vars={{ spriteUrl: `url(${spriteUrl})` }}>
  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Two 64px frames side by side, drawn at 32px so the mark stays sharp on
     hi-dpi screens. steps(2) holds each frame for half of --logo-blink-cycle,
     matching the favicon's blink in src/scripts/animatedFavicon.ts. */
  .footer-mark {
    display: inline-block;
    width: 32px;
    height: 32px;
    background-image: var(--spriteUrl);
    background-repeat: no-repeat;
    background-size: 64px 32px;
    background-position: 0 0;
    animation: footer-mark-blink var(--logo-blink-cycle) steps(2) infinite;
  }

  @keyframes footer-mark-blink {
    from {
      background-position: 0 0;
    }
    to {
      background-position: -64px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-mark {
      animation: none;
    }
  }
</style>
