---
import { getEntry, render } from "astro:content";
import { projects } from "../../data/projects";
import ProjectLayout from "../../layouts/ProjectLayout.astro";

const project = projects.find((entry) => entry.slug === "objekt-tools");

if (!project) {
  throw new Error("Missing project data for objekt-tools");
}

const writeup = await getEntry("pages", "objekt-tools");
if (!writeup) {
  throw new Error("Missing src/content/pages/objekt-tools.md");
}
const { Content } = await render(writeup);
---

<ProjectLayout project={project}>
  <Content />
</ProjectLayout>
