---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="lab | sharkbeans" description="Smaller experiments, placeholders, and unfinished ideas.">
  <div class="stack">
    <header class="page-header">
      <p class="eyebrow">lab</p>
      <h1>Experiments</h1>
      <p class="lede">
        Smaller builds that aren't full projects yet.
      </p>
    </header>

    <ul class="project-list">
      <li class="project-list__item">
        <div class="project-list__heading">
          <strong>RetroCam</strong>
          <span class="meta-chip">placeholder</span>
        </div>
        <p>An experiment with browser-based retro camera filters and CCD-style effects.</p>
      </li>
      <li class="project-list__item">
        <div class="project-list__heading">
          <strong>Web TCG experiments</strong>
          <span class="meta-chip">placeholder</span>
        </div>
        <p>Notes for browser-based card interfaces, collection UX, and small rule systems.</p>
      </li>
      <li class="project-list__item">
        <div class="project-list__heading">
          <strong>3D browser experiments</strong>
          <span class="meta-chip">placeholder</span>
        </div>
        <p>Rendering and interaction tests that might become proper projects later.</p>
      </li>
    </ul>
  </div>
</BaseLayout>
