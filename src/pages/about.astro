---
import SocialLinks from "../components/SocialLinks.astro";
import { profile } from "../data/profile";
import { socials } from "../data/socials";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="about | sharkbeans" description="A short personal page.">
  <div class="stack">
    <header class="page-header">
      <p class="eyebrow">about</p>
      <h1>Hi, I'm {profile.firstName}.</h1>
    </header>

    <div class="prose">
      <p>
        I build web products and collector tools.
      </p>
      <p>
        Most of my time goes into static sites, small apps, and side projects, kept readable
        after the first version ships.
      </p>
      <p>
        Right now that mostly means shipping <a href={`${base}projects/mybeli/`}>MyBeli</a>, a
        multi-tenant Elixir/Phoenix LiveView catalog platform, alongside the usual TypeScript work.
      </p>
      <p>
        Day to day: Linux, TypeScript, Elixir, and Astro.
      </p>

      <h2>Links</h2>
      <SocialLinks links={socials} />
    </div>
  </div>
</BaseLayout>
