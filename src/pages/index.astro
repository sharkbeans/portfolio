---
import { getCollection } from "astro:content";

import GameCanvas from "../components/game/GameCanvas.astro";
import PostList from "../components/PostList.astro";
import ProjectList from "../components/ProjectList.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { featuredProjects } from "../data/projects";
import { profile } from "../data/profile";
import { socials } from "../data/socials";
import BaseLayout from "../layouts/BaseLayout.astro";

const recentPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3)
  .map((entry) => ({
    url: `/blog/${entry.id}/`,
    title: entry.data.title,
    description: entry.data.description,
    tags: entry.data.tags,
    draft: entry.data.draft,
    pubDate: entry.data.pubDate,
  }));
---

<BaseLayout title={profile.siteLabel} description={profile.homeBlurb}>
  <div class="home-shell">
    <div class="home-shell__map">
      <GameCanvas />
    </div>

    <div class="home-shell__content stack" id="journey-content">
      <section class="home-intro" id="home-intro">
        <p class="eyebrow">~</p>
        <h1>{profile.introHeading}</h1>
        <p class="lede">{profile.intro}</p>
        <p>{profile.homeBlurb}</p>
        <p class="inline-links">
          <a href="#selected-projects">selected projects</a>
          <a href="#recent-writing">recent writing</a>
          <a href="#public-links">public links</a>
        </p>
      </section>

      <section id="selected-projects" class="stack">
        <div>
          <p class="eyebrow">projects</p>
          <h2 class="section-title">Things I build</h2>
        </div>
        <p>
          The homepage only shows a short slice. The full archive lives on the{" "}
          <a href="/projects">projects page</a>.
        </p>
        <ProjectList projects={featuredProjects} />
      </section>

      <section id="recent-writing" class="stack">
        <div>
          <p class="eyebrow">blog</p>
          <h2 class="section-title">Recent writing</h2>
        </div>
        <p>
          The archive is intentionally simple. Right now the posts are visible draft placeholders
          rather than pretending to be finished essays.
        </p>
        <PostList posts={recentPosts} />
      </section>

      <section id="public-links" class="stack">
        <div>
          <p class="eyebrow">links</p>
          <h2 class="section-title">Public profiles</h2>
        </div>
        <SocialLinks links={socials} />
      </section>

      <section id="continue-exploring" class="stack">
        <div>
          <p class="eyebrow">continue</p>
          <h2 class="section-title">Elsewhere on the site</h2>
        </div>
        <ul class="plain-list route-list">
          <li>
            <a href="/projects">/projects</a> for the full archive and case studies.
          </li>
          <li>
            <a href="/blog">/blog</a> for notes and project write-ups.
          </li>
          <li>
            <a href="/uses">/uses</a> for software and hardware notes.
          </li>
          <li>
            <a href="/about">/about</a> for a short first-name-only introduction.
          </li>
          <li>
            <a href="/lab">/lab</a> for smaller unfinished experiments.
          </li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .home-shell {
    display: grid;
    grid-template-columns: minmax(18rem, 24rem) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .home-shell__content {
    min-width: 0;
  }

  .route-list {
    display: grid;
    gap: 0.75rem;
  }

  @media (max-width: 64rem) {
    .home-shell {
      grid-template-columns: 1fr;
    }
  }
</style>
