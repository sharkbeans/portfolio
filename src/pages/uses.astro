---
import { usesSections } from "../data/uses";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="uses | sharkbeans" description="Software, hardware, and development tools.">
  <div class="stack">
    <header class="page-header">
      <p class="eyebrow">uses</p>
      <h1>Software &amp; hardware</h1>
      <p class="lede">
        What I'm currently using, updated as it changes.
      </p>
    </header>

    {
      usesSections.map((section) => (
        <section class="stack">
          <div>
            <h2>{section.title}</h2>
            {section.intro ? <p>{section.intro}</p> : null}
          </div>
          <table>
            <tbody>
              {section.entries.map((entry) => (
                <tr>
                  <th>{entry.name}</th>
                  <td>
                    {entry.href ? (
                      <a href={entry.href} target="_blank" rel="noreferrer">
                        {entry.detail}
                      </a>
                    ) : (
                      entry.detail
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))
    }
  </div>
</BaseLayout>
