---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 | sharkbeans" description="The page could not be found." noIndex={true}>
  <div class="stack">
    <p class="eyebrow">404</p>
    <h1>That page wandered off the map.</h1>
    <p>The content is missing, renamed, or not published yet.</p>
    <p>
      Try the <a href={base}>homepage</a> or the <a href={`${base}projects`}>projects archive</a>.
    </p>
  </div>
</BaseLayout>
