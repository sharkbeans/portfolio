---
import BaseLayout from "./BaseLayout.astro";
import BlogArchive from "../components/BlogArchive.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  draft?: boolean;
  previousPost?: { title: string; url: string };
  nextPost?: { title: string; url: string };
  canonicalUrl?: string;
}

const { title, description, pubDate, updatedDate, tags = [], draft = false, previousPost, nextPost } =
  Astro.props;

const base = import.meta.env.BASE_URL;
const archiveHref = `${base}blog`;
const fullTitle = `${title} | blog | sharkbeans`;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(date);
---

<BaseLayout title={fullTitle} description={description} noIndex={draft}>
  <article class="prose-shell prose-shell--door">
    <header class="page-header">
      <p class="eyebrow">blog</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="meta-line">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate ? <> · updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></> : null}
        {draft ? <> · draft placeholder</> : null}
      </p>
      {tags.length > 0 ? <p class="tag-list">{tags.map((tag) => `#${tag}`).join(" ")}</p> : null}
    </header>

    <div class="prose">
      <slot />
    </div>

    <nav class="post-nav" aria-label="Post navigation">
      <div>{previousPost ? <a href={previousPost.url}>Previous: {previousPost.title}</a> : <span />}</div>
      <div>{nextPost ? <a href={nextPost.url}>Next: {nextPost.title}</a> : <span />}</div>
    </nav>
  </article>

  <Fragment slot="door-layers">
    <div class="door-runway"></div>

    <div class="door-underlay" aria-hidden="true" inert>
      <Header pathname={archiveHref} />
      <div class="site-main">
        <BlogArchive />
      </div>
      <Footer />
    </div>

    <div class="door-panel" data-door-archive={archiveHref}></div>
  </Fragment>
</BaseLayout>

<script>
  import { wireDoors } from "../scripts/pageTransition";

  wireDoors();
</script>
